{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tanchiki-server",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
